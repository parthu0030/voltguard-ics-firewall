# VoltGuard — .gitignore
# ==========================

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ── Virtual Environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.local

# ── Environment files (may contain secrets) ────────────────────────────────
.env
.env.*
!.env.example

# ── Database ────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
# SQLite WAL mode creates these mutable sidecars at runtime.  They must not
# be versioned: a stale/corrupt WAL can prevent the main database opening.
*.db-wal
*.db-shm

# ── Logs (generated at runtime) ─────────────────────────────────────────────
logs/*.log
logs/*.log.*

# ── Reports (generated at runtime) ──────────────────────────────────────────
reports/*.pdf
reports/*.csv
reports/*.txt

# ── Build / Distribution ────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
wheels/

# ── IDE / Editor ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Testing / Coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
*.coveragerc

# ── Type Checking ────────────────────────────────────────────────────────────
.mypy_cache/
.pytype/

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Temporary files ──────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
.voltguard_write_test
